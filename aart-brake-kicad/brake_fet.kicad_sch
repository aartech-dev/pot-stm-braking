	(title_block
		(title "AART Brake Module — 4: Brake FET Circuit")
		(date "2026-06-03")
		(rev "2.0")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "GD1 UCC27524, R2 safe-default, R3 gate, Q1 IRLB3034 N-ch, D2 SS310")
		(comment 2 "TIM3_CH1 INVERTED polarity: CCR=0 = FET ON = dead short")
	)
	(lib_symbols)
	(text "R2 10k\nsafe-default\npull-up on\nGD1 INPUT"
		(exclude_from_sim no)
