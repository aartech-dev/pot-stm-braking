				(size 1.2 1.2)
				(bold yes)
			)
		)
		(uuid "af10fa8d-bb47-40dc-8ac8-e82ee49cb79b")
	)
	(text "PA6  TIM3_CH1 AF1  Brake PWM -> GD1 -> Q1 (INVERTED polarity)\nPA7  TIM3_CH2 AF1  Keep-alive PWM -> GD2 -> Q2 (normal polarity)\nPA9  USART1_TX AF1 UART debug/bootloader TX  115200 8N1\nPA10 USART1_RX AF1 UART RX\nPA13 SWDIO AF0     SWD debug interface\nPA14 SWDCLK AF0    SWD debug interface\nPB6  GPIO out      Status LED (blinks 3x on flash save)\nNRST             Reset input"
		(exclude_from_sim no)
		(at 228.28 105.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "b5b9f09b-c9d1-4ab0-b285-0009a8f7505b")
	)
