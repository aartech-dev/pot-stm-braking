	(paper "A3")
	(title_block
		(title "AART Brake Module — 2: MCU + Inputs")
		(date "2026-06-03")
		(rev "2.0")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "U1 STM32G041K6U6, decoupling, pot, toggle, capture button, rail sense")
	)
	(lib_symbols)
	(text "PA0 ADC_IN0  WHITE rail sense  R8=18k/R9=4k7 divider  3.31V at 16V\nPA1 ADC_IN1  BLACK track sense R10=22k/R11=4k7 divider  2.82V at 16V\nPA2 GPIO in  Toggle bit0 (mode select) pull-up active-LOW\nPA3 ADC_IN3  Pot wiper (10k centre-detent, CCW=min brake)\nPA4 GPIO in  Toggle bit1 (mode select) pull-up active-LOW\nPA5 ADC_IN5  Capture button (10k pull-up + 1k series to GND)"
		(exclude_from_sim no)
		(at 123.28 89.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "120cd872-9188-4dd3-86f3-8eb22c2f6195")
	)
	(text "LEFT SIDE INPUTS (PA0-PA5):"
		(exclude_from_sim no)
		(at 134.112 82.296 0)
		(effects
			(font
				(size 1.2 1.2)
				(bold yes)
			)
		)
		(uuid "24682373-97b9-4707-b13f-fdd83b52ecb0")
	)
	(text "RAIL SENSE DIVIDERS:\nWHITE: R8=18k (top) R9=4k7 (bot) -> 3.31V at 16V rail\nBLACK: R10=22k (top) R11=4k7 (bot) -> 2.82V at 16V rail\nBoth safe for 3.3V ADC reference."
		(exclude_from_sim no)
		(at 228.28 177.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2a9d47b2-d95f-4a0c-b7a5-fe7b950b3dc7")
	)
	(text "Place U1 here with:\n  C5 100nF + C6 100nF + C7 4u7 (VDD/VDDA decoupling)\n  R1 10k (NRST pull-up to 3.3V)"
		(exclude_from_sim no)
		(at 194.28 120.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "98a30697-0ad1-49f9-b279-8a208b85a8b0")
	)
	(text "TOGGLE DECODING:\nPA2=H PA4=H -> Mode A (brushed + positive anti-brake)\nPA2=L PA4=H -> Mode B (brushed, reduced braking only)\nPA2=H PA4=L -> Mode C (brushless, eCom keep-alive)\nPA2=L PA4=L -> invalid -> defaults to Mode B (safe)"
		(exclude_from_sim no)
		(at 120.142 177.292 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "9f8a74c8-8217-4217-97a5-7ed9fdbc351a")
	)
	(text "U1 STM32G041K6U6 QFN-32"
		(exclude_from_sim no)
		(at 198.882 115.062 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "a70c2b73-d17c-4f53-b781-589ca64a8e6b")
	)
	(text "RIGHT SIDE OUTPUTS (PA6, PA7, PA9, PA10, PA13, PA14, PB6):"
		(exclude_from_sim no)
		(at 227.584 97.028 0)
		(effects
			(font
				(size 1.2 1.2)
				(bold yes)
			)
		)
		(uuid "af10fa8d-bb47-40dc-8ac8-e82ee49cb79b")
	)
	(text "PA6  TIM3_CH1 AF1  Brake PWM -> GD1 -> Q1 (INVERTED polarity)\nPA7  TIM3_CH2 AF1  Keep-alive PWM -> GD2 -> Q2 (normal polarity)\nPA9  USART1_TX AF1 UART debug/bootloader TX  115200 8N1\nPA10 USART1_RX AF1 UART RX\nPA13 SWDIO AF0     SWD debug interface\nPA14 SWDCLK AF0    SWD debug interface\nPB6  GPIO out      Status LED (blinks 3x on flash save)\nNRST             Reset input"
		(exclude_from_sim no)
		(at 228.28 105.15 0)
