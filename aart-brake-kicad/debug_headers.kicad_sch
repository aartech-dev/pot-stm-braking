	(paper "A4")
	(title_block
		(title "AART Brake Module — 3: Debug + Flash Headers")
		(date "2026-06-03")
		(rev "2.0")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "J10 SWD, J11 UART, J12 BOOT0 button, J13 NRST button")
	)
	(lib_symbols)
	(text "Pin 1: SWDIO (PA13 AF0)\nPin 2: SWDCLK (PA14 AF0)\nPin 3: GND\nPin 4: +3.3V (optional - powers target from programmer)"
		(exclude_from_sim no)
		(at 168.91 43.688 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "0e26dcad-24f6-4a59-a5d6-8dcde61119d3")
	)
	(text "Connect ST-Link V2/V3. PA13/PA14 default to SWD after reset.\nFull hardware debug: breakpoints, live variable watch.\nUse debug.sh script: starts OpenOCD + GDB at main()."
		(exclude_from_sim no)
		(at 168.91 51.688 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "34a2a9ce-ddd5-413a-86e5-466fa111e24d")
	)
	(text "J11 — UART DEBUG / BOOTLOADER (3-pin 2.54mm)"
		(exclude_from_sim no)
		(at 116.29 74.4 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "34ac97db-f12b-47a5-b5b8-7932d9bedd24")
	)
	(text "J12 — BOOT0 BUTTON (2-pin 2.54mm)"
		(exclude_from_sim no)
		(at 116.29 104.4 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "7919aee2-b328-436b-954c-4b97d65235c5")
	)
	(text "Telemetry: tick,state,mode,white_mv,black_mv,brake_ccr,\n           ka_ccr,pot_raw,ramp_ms,brake_active,latvian_active\nCommands: SET BRAKE_ENTER/EXIT/SOFT, SET KA_MAX,\n          SET LATVIAN_DVDT, SAVE, GET, HELP"
		(exclude_from_sim no)
		(at 168.91 86.962 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "89ef7248-7ce3-41e5-98c9-f1ab607dcce3")
	)
	(text "Momentary button pulls PB8/BOOT0 to 3.3V via 10k.\nNormally LOW via internal MCU pull-down.\nHold J12 + press J13 = ROM UART bootloader entry on PA9/PA10.\nFlash: stm32flash -w aart_brake.bin /dev/ttyUSB0"
		(exclude_from_sim no)
		(at 156.29 106.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "9952aed2-ee91-4bf4-91dd-dde19eff47fa")
	)
	(text "Pin 1: TX (PA9 USART1 AF1) -> RX of USB-UART adapter\nPin 2: RX (PA10 USART1 AF1) -> TX of USB-UART adapter\nPin 3: GND\n115200 8N1, 3.3V logic level. Do NOT connect 5V directly."
		(exclude_from_sim no)
		(at 168.91 76.962 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "c96bde0d-e77f-494b-9863-9a5862e18535")
	)
	(text "J13 — NRST BUTTON (2-pin 2.54mm)"
		(exclude_from_sim no)
		(at 116.29 126.4 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "cf707019-deb6-403e-8f16-3b98eab9e865")
	)
	(text "J10 — SWD DEBUG HEADER (4-pin 2.54mm)"
		(exclude_from_sim no)
		(at 116.29 44.4 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "e1024be7-a140-4336-a6f3-fce295ffafe2")
	)
	(text "Momentary button pulls NRST to GND.\nPress while holding J12 BOOT0 to enter bootloader.\nRelease J13 first, then release J12."
		(exclude_from_sim no)
		(at 156.29 129.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "fcbe1556-6f34-4f03-82ef-69d0f291e5f0")
	)
