	(text "4mm banana WHITE input\n+12-16V always-live from track PSU (40-90A source)\nModule draws only ~35mA from this rail via F1 and LDO\nTrack power path (BLACK) bypasses this circuit entirely"
		(exclude_from_sim no)
		(at 76.454 68.58 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "92787d68-dee8-4fb3-991d-543b206e3722")
	)
	(text "TVS selection note:\nP6KE18CA — bidirectional (CA suffix) is ESSENTIAL.\nUnidirectional P6KE18A only clamps one polarity.\nInductive switching on this rail produces transients\nin both directions."
		(exclude_from_sim no)
		(at 154.93 107.2 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "982b690c-f8e0-40b6-97a7-d92644041c2f")
	)
	(text "LDO power dissipation:\n  12.4V rail: P = (12.4-3.3) x 0.035 = 0.32W, dT = 20C\n  16.0V rail: P = (16.0-3.3) x 0.035 = 0.44W, dT = 27C\nBoth within AMS1117-3.3 125C Tj limit at 25C ambient.\nSolder SOT-223 tab to copper pour for best performance."
		(exclude_from_sim no)
		(at 89.93 107.2 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
