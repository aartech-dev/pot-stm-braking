	(uuid "b477b631-9902-40f7-8ce2-ad1d742e45ce")
	(paper "A4")
	(title_block
		(title "AART Brake Module — 5: Keep-alive FET Circuit")
		(date "2026-06-03")
		(rev "2.0")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "GD2 UCC27524, R4 gate, Q2 IRF9Z34N P-ch, D3 SS310, D4 MBRS360")
		(comment 2 "D4 ESSENTIAL in mode C — blocks reverse current into Q2")
	)
	(lib_symbols)
	(text "Q2 P-CHANNEL OPERATION:\nQ2 is a high-side switch: source connects to +12V rail,\ndrain connects to track via D4.\nP-channel: gate LOW (relative to source) = FET ON.\nGate driven by GD2 (UCC27524) from 3.3V rail.\nWhen GD2 output = 0V, Vgs = 0 - 12V = -12V => fully enhanced.\nWhen GD2 output = 3.3V, Vgs = 3.3 - 12V = -8.7V => still enhanced.\nIRF9Z34N Vgs(th) = -2V to -4V, so 3.3V gate drive is sufficient."
		(exclude_from_sim no)
		(at 28.956 83.312 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "04421c86-ccfe-46a0-a05a-dab6675a07bf")
	)
	(text "TIM3_CH2 NORMAL POLARITY:\nCCR = 0         => output pin LOW  => Vgs negative => Q2 OFF\nCCR = 400(KA_MAX) => PWM 12.5% duty => ~2V effective at 16V rail\nEffective voltage = (CCR / 3200) x V_RAIL\nAdjust KA_MAX via UART: SET KA_MAX <ccr>"
		(exclude_from_sim no)
		(at 28.956 106.312 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "1213f5bb-b50b-4504-b906-21897e05e14f")
	)
	(text "D4 MBRS360 — MODE C ESSENTIAL:\nIn mode C, Q2 injects keep-alive while Q1 may simultaneously\ndeadshort the track. D4 blocks reverse current back through Q2.\nWithout D4: Q2 body diode conducts ~46A at 20kHz repetitively.\nIRF9Z34N body diode is not rated for this.\nD4 is the most electrically stressed diode in this design.\nSS34 (3A/80A peak) is marginal. MBRS360 (3A/60V) is specified.\nD4 can be omitted on mode A/B-only boards."
		(exclude_from_sim no)
		(at 28.956 126.312 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "7158bfdb-2a92-47e3-9460-5afa98f92433")
	)
	(text "R4\n10R\ngate"
		(exclude_from_sim no)
		(at 158.11 61.74 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "81d24d4b-57d6-47d6-894f-d7dd9b310bc8")
	)
	(text "D3 SS310 CATCH DIODE:\nConnected across Q2 drain-source.\nProtects against inductive voltage spikes on Q2 turn-off.\n100V rating required on 16V rail — same reasoning as D2."
		(exclude_from_sim no)
		(at 28.956 153.312 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "8a01d346-0874-4705-bd36-49341b87d739")
	)
	(text "D4\nMBRS360\nseries\noutput"
		(exclude_from_sim no)
		(at 195.11 71.74 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "90ce0602-5341-4cef-a66c-b02f3ac3b3b1")
	)
	(text "GD2\nUCC27524\nSOT-23-5"
