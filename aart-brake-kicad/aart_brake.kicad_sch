	(paper "A2" portrait)
	(title_block
		(title "AART Slot Car Braking Module")
		(date "2026-06-03")
		(rev "2.0")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "TOP LEVEL — double-click a sheet symbol to open it")
		(comment 2 "STM32G041K6U6 QFN-32 | libopencm3 | Firmware Rev 6")
	)
	(lib_symbols)
	(text "FETs and Diodes\nQ1  IRLB3034  D2PAK  N-ch brake FET (195A 40V)\nQ2  IRF9Z34N  D2PAK  P-ch keep-alive FET (18A 55V)\nD1  P6KE18CA  SMB    TVS bidirectional — CA suffix ESSENTIAL\nD2  SS310     SMB    Q1 catch diode 100V required\nD3  SS310     SMB    Q2 catch diode 100V required\nD4  MBRS360   SMB    Mode C series protection — most stressed\nD5  LED Red   0805   Status LED"
		(exclude_from_sim no)
		(at 112.292 166.878 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "2d8d73fd-3ee5-4a39-87b5-6045f6878a08")
	)
	(text "Connectors\nJ1-J6  4mm banana  Track WHITE/BLACK/RED (x2 sides)\nJ7     3-pin 2.54mm  Mode toggle A/B/C\nJ8     2-pin 2.54mm  Capture button\nJ9     2-pin 4mm     Track output\nJ10    4-pin 2.54mm  SWD: SWDIO/SWDCLK/GND/+3V3\nJ11    3-pin 2.54mm  UART: TX/RX/GND  115200 8N1\nJ12    2-pin 2.54mm  BOOT0 button (ROM bootloader)\nJ13    2-pin 2.54mm  NRST button"
		(exclude_from_sim no)
		(at 36.322 192.278 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "61f299aa-5772-466a-ad4b-d7356d0fee5f")
	)
	(text "ICs\nU1  STM32G041K6U6  QFN-32    MCU\nU2  AMS1117-3.3    SOT-223   LDO 12-16V -> 3.3V\nGD1 UCC27524       SOT-23-5  Brake gate driver\nGD2 UCC27524       SOT-23-5  Keep-alive gate driver"
		(exclude_from_sim no)
		(at 47.292 166.878 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "89d2da1c-3012-493b-829a-78deaa4dd9b1")
	)
	(text "Passives\nF1  500mA-1A polyfuse  1812   WHITE rail MCU supply ONLY\nC1  10uF   0805   LDO input bulk\nC2  100nF  0402   LDO input HF\nC3  10uF   0805   LDO output bulk\nC4  100nF  0402   LDO output HF\nC5  100nF  0402   MCU VDD decouple\nC6  100nF  0402   MCU VDDA decouple\nC7  4u7    0402   MCU VDDA bulk"
		(exclude_from_sim no)
		(at 177.292 166.878 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "a0b8b692-d86f-460c-89ac-dc3bc4da35a6")
	)
	(text "KEY DESIGN NOTES:"
		(exclude_from_sim no)
		(at 41.656 212.154 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "a6acee4a-c6f2-4a83-afd4-2f3cbae912fc")
	)
	(text "Resistors\nR1   10k  0402  NRST pull-up\nR2   10k  0402  GD1 safe-default (on INPUT not gate)\nR3   10R  0402  Q1 gate\nR4   10R  0402  Q2 gate\nR5   10k  0402  Pot reference to 3.3V\nR6   10k  0402  Capture btn pull-up\nR7   1k   0402  Capture btn series\nR8   18k  0402  WHITE sense top divider\nR9   4k7  0402  WHITE sense bottom\nR10  22k  0402  BLACK sense top divider\nR11  4k7  0402  BLACK sense bottom\nR12  330R 0402  Status LED"
		(exclude_from_sim no)
		(at 227.292 166.878 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "cd61e05c-3325-4d62-aa4a-d520fa9c17e0")
	)
	(text "COMPONENT LIST (Rev 9):"
		(exclude_from_sim no)
		(at 46.482 158.242 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "f35076fd-bead-4139-bf95-efcba0833ad5")
	)
	(text "Q1 TIM3_CH1 INVERTED polarity: CCR=0 = FET ON = dead short\nR2 pull-up on GD1 INPUT (not Q1 gate) = safe default brake at power-off\nD4 ESSENTIAL in mode C: blocks reverse current into Q2 during hard braking\nF1 in WHITE rail ONLY — never in BLACK track path (40A motor startup)\nD1 P6KE18CA — bidirectional variant — clamps both polarity transients\nD2/D3 SS310 100V — inductive turn-off spikes on 16V rail need 100V rating"
		(exclude_from_sim no)
		(at 36.322 220.726 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "fb70261d-0119-4526-a446-b7636082ce08")
	)
