	(uuid "91c9a698-72e3-497c-b19d-a7bbe96d932b")
	(paper "A4")
	(title_block
		(title "AART Brake Module — 4: Brake FET Circuit")
		(date "2026-06-19")
		(rev "11")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "GD2 op-amp linear buffer, R2 safe-default pull-up, R3 gate 10R, Q2 IRFP250N wide-SOA N-ch, D2 SS310")
		(comment 2 "DAC1 PA4 -> op-amp buffer (linear mode). No PWM. Resistance-controlled brake via stored tables.")
	)
	(lib_symbols)
	(text "R3\n10R\ngate"
		(exclude_from_sim no)
		(at 167 70 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "3f4d4dd6-edb6-4efd-abcc-0b7aad8928c1")
	)
	(text "SAFE DEFAULT — CRITICAL:\nR2 (10k) is on the GD2 INPUT pin, NOT on Q2 gate.\nWhen the MCU is unpowered/reset, the GD2 input is pulled to a\nsafe-default level so Q2 defaults to braking. If R2 were on the\ngate, the buffer would fight it."
		(exclude_from_sim no)
		(at 15 125 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "8bc6b72e-fdd7-415a-a82c-1991dad29aad")
	)
	(text "RESISTANCE-CONTROLLED BRAKE (linear, no PWM):\nDAC1 (0-3.3V) -> GD2 op-amp buffer -> Q2 gate.\nQ2 is operated in its LINEAR region: gate voltage sets Rds,\nwhich is placed across the motor (low-side, TRACK_POS to RED).\nMode B indexes one of seven stored brake tables\n(25/15/5/4/3/2/1 ohm full scale); Mode A linear-maps the pot.\nNo switching, no PWM, no switching noise."
		(exclude_from_sim no)
		(at 15 100 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "962b66a2-39eb-409c-8d5c-04f64120a613")
	)
	(text "Q2 IRFP250N — WIDE-SOA, HEATSINK REQUIRED:\nLinear operation requires a wide-SOA planar part. The former\nIRLB3034 (trench switching FET) has poor linear-mode SOA and\nrisks secondary breakdown. Worst-case ~12W mid-range; brake is\nintermittent (~10-20% duty) but the heatsink must take the peak.\nSee design doc 7A.8.1."
		(exclude_from_sim no)
		(at 15 145 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "a568f181-abcd-4455-9caa-3283cd40fd7c")
	)
	(text "D2 SS310 CATCH DIODE — ESSENTIAL:\nMotor inductance produces a large voltage spike on current\ninterruption. SS310 (100V) chosen for headroom on the 16V rail.\nClamps the spike to Vf + Vdc."
		(exclude_from_sim no)
		(at 15 168 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "be593265-9e83-4f00-b27b-97ce904a6994")
	)
	(text "Q2\nIRFP250N\nwide-SOA N-ch\nTO-247 + heatsink\n30A 200V"
		(exclude_from_sim no)
		(at 191 64 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "d98a9d15-9a2f-4ddc-9780-9d23efcafdb6")
	)
	(text "R2 10k\nsafe-default\npull-up on\nGD2 INPUT"
		(exclude_from_sim no)
		(at 123 55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "ebdc8b99-7459-4f80-80e2-0bdfb5e9a882")
	)
	(text "D2\nSS310\ncatch\n100V"
