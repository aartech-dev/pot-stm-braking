	(title_block
		(title "AART Brake Module — 7: Reverse-Blocking Pass Switch (two N-channel + TPS1212-Q1)")
		(date "2026-06-19")
		(rev "11")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "Q5/Q6 common-source N-ch pair on BLACK; U5 TPS1212-Q1 smart high-side controller, VS from WHITE; RSNS current sense")
		(comment 2 "Reverse block (I_DIR) + I2t OCP + 5us SCP + IMON/FLT. Reverse response ~6-10us. Replaces LTC7001+INA241+comparator.")
	)
	(lib_symbols)
