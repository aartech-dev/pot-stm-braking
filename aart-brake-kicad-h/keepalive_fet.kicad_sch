	(paper "A4")
	(title_block
		(title "AART Brake Module — 5: Anti-brake constant-current source (3A, PWM-set)")
		(date "2026-06-19")
		(rev "11")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "High-side op-amp current source: GD1 (HV op-amp on WHITE rail) + Q1 TIP147 PNP Darlington + Rsense 0.1ohm. I = Vdemand/Rsense, max 3A.")
		(comment 2 "Demand = 50kHz PWM from MCU, level-shifted (2N2222) + RC filtered (470n) to DC. D4 MBRS360 reverse block.")
	)
	(lib_symbols)
	(text "GD1\nHV op-amp current loop\n(WHITE rail, 0-16V)\nLM321/LM358-class >=16V"
		(exclude_from_sim no)
		(at 138 104 0)
		(effects
			(font
