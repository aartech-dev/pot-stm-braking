  (text "J2" (at 18 30 0) (effects (font (size 1.27 1.27))))
  (text "F1\n500mA-1A\npolyfuse" (at 33 27 0) (effects (font (size 1.0 1.0)) (justify left)))
  (text "D1\nP6KE18CA\nTVS bidirectional" (at 53 35 0) (effects (font (size 1.0 1.0)) (justify left)))
