	(paper "A4")
	(title_block
		(title "AART Brake Module — 1: Power Supply")
		(date "2026-06-19")
		(rev "11")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "WHITE -> F1 polyfuse -> U2 LDO +3V3 (MCU). U4 LDO +5V (GD2 brake buffer only; GD1 anti-brake op-amp is on WHITE). D1 TVS on WHITE.")
		(comment 2 "TPS1212-Q1 VS ties to WHITE directly (3.5-73V, no clamp needed). F1 in WHITE rail ONLY.")
	)
	(lib_symbols)
	(text "F1\n500mA-1A\npolyfuse"
		(exclude_from_sim no)
		(at 33 24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "0da6d050-e2e8-4680-951e-83a49b982abe")
	)
	(text "U4\nMCP1700-5002\nSOT-23 -> +5V\nanalog rail"
		(exclude_from_sim no)
		(at 101 33 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2a614cff-99f5-40a4-a774-15bd6ad8c42c")
	)
	(text "+3V3 RAIL (U2):\n  16.0V rail: P = (16.0-3.3) x 0.035 = 0.44W, dT ~27C in SOT-223.\nAMS1117 handles the thermal at 16V in but has ~5mA quiescent;\nMCP1700 is 2uA Iq but higher Rth in SOT-23 — pick per standby\nbudget vs package thermal (see design doc 7A.6)."
		(exclude_from_sim no)
		(at 15 85 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2b828750-0bea-4ad7-b7e1-bd202a414477")
	)
	(text "TPS1212-Q1 SUPPLY (no clamp):\nThe reverse-switch controller U5 (TPS1212-Q1) VS pin\nconnects to WHITE directly - its 3.5-73V range covers the\n16V rail, so the DZ1/RZ1 zener clamp the LTC7001 needed is\nremoved. U5 also self-protects via I2t/SCP. See reverse_switch sheet."
		(exclude_from_sim no)
		(at 15 108 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2c1ca28f-386c-44f9-b5eb-afa1f0b9215f")
	)
	(text "U2\nAMS1117-3.3\n(or MCP1700)\nSOT-223 -> +3V3"
		(exclude_from_sim no)
		(at 76 21 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "4760c5ca-ff02-45fd-b5ca-000da3a3a67b")
	)
	(text "+5V RAIL (U4):\nFeeds the GD2 brake-buffer op-amp only. NOTE: the GD1 anti-brake\ncurrent-source op-amp is NOT on this rail - it is powered from WHITE (~16V)\nbecause it senses in the WHITE leg at ~16V common mode (a 5V op-amp cannot).\n~11V drop from WHITE at mA-level load = negligible heat in SOT-23."
		(exclude_from_sim no)
		(at 15 60 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "7615d99b-26c2-4b7c-b52e-c9b4dc77b33f")
	)
	(text "D1\nP6KE18CA\nTVS bidir"
		(exclude_from_sim no)
		(at 53 35 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "76a4a46d-c229-4939-89f5-e3fbdef820c4")
	)
	(text "TVS selection:\nP6KE18CA bidirectional (CA suffix) ESSENTIAL — clamps both\npolarities of inductive transient on the WHITE rail."
		(exclude_from_sim no)
		(at 80 85 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "81a9ca5f-f03b-49b3-967c-c7657a285fdc")
	)
	(text "J2 WHITE"
		(exclude_from_sim no)
		(at 14 30 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "8bd4bf65-4764-4db2-879f-dd2649e6d590")
	)
	(text "C1 C2\nLDO in"
		(exclude_from_sim no)
		(at 69 33 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "aa8989bc-a632-4a23-8482-580924a626ba")
	)
	(text "USB POWER PATH:\nVBUS -> F_USB (500mA polyfuse) -> D_USB (BAT54) -> LDO input node.\nD_USB anode=VBUS, cathode=LDO_in. Reversed = HOST DAMAGE.\nR_CC1/R_CC2 5.1k CC pull-downs; C_USB1 10uF VBUS bulk."
		(exclude_from_sim no)
		(at 15 130 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "ac2a330c-73de-464d-9a59-c898be6625ce")
	)
