		(uuid "dec55f5d-59dc-44b0-820d-4fc87987d7bb")
	)
	(text "Connectors\nJ1-J6  4mm banana  Track + controller WHITE/BLACK/RED (x2 sides)\nJ7  3-pin 2.54mm  Mode toggle A/B/C (PB0/PB1/GND)\nJ10 4-pin SWD  J11 3-pin UART  J12 BOOT0  J13 NRST\nJ14 3-pin voltmeter\nNOTE: J9 capture button REMOVED (toggle replaces it; PB3 reserved/optional)"
		(exclude_from_sim no)
		(at 38.862 331.978 0)
