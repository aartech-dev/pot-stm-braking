		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "J1-J6 4mm banana. WHITE and RED pass straight through; BLACK routes through the reverse-block switch (sheet 7).")
		(comment 2 "Controller BLACK (J4) = CTRL_BLACK_IN -> switch -> TRACK_POS = track BLACK (J3).")
	)
