	(text "BRAKE DETECTION (this module):\nV_BLACK < 500mV  => enter brake state\nV_BLACK > 1500mV => exit brake state\nHysteresis prevents chatter at low throttle."
		(exclude_from_sim no)
		(at 45 152 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
