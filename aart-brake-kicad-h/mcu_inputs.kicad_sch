  (text "U1 STM32G051K6U6 QFN-32" (at 86 60 0)
    (effects (font (size 1.5 1.5) bold)))
  (text "Place U1 here with:\n  C5 100nF + C6 100nF + C7 4u7 (VDD/VDDA decoupling)\n  R1 10k (NRST pull-up to 3.3V)" (at 86 63 0)
    (effects (font (size 1.0 1.0)) (justify left)))
  (text "LEFT SIDE INPUTS (PA0-PA5):" (at 35 48 0)
    (effects (font (size 1.2 1.2) bold)))
  (text "PA0 ADC_IN0  WHITE rail sense  R8=18k/R9=4k7 divider  3.31V at 16V\nPA1 ADC_IN1  BLACK track sense R10=22k/R11=4k7 divider  2.82V at 16V\nPA2 GPIO in  Toggle bit0 (mode select) pull-up active-LOW\nPA3 ADC_IN3  Pot wiper (10k centre-detent, CCW=min brake)\nPA4 GPIO in  Toggle bit1 (mode select) pull-up active-LOW\nPA5 ADC_IN5  Capture button (10k pull-up + 1k series to GND)" (at 15 32 0)
    (effects (font (size 1.0 1.0)) (justify left)))
  (text "RIGHT SIDE OUTPUTS (PA6, PA7, PA9, PA10, PA13, PA14, PB6):" (at 120 45 0)
    (effects (font (size 1.2 1.2) bold)))
  (text "PA6  TIM3_CH1 AF1  Brake PWM -> GD2 -> Q2 (INVERTED polarity)\nPA7  TIM3_CH2 AF1  Keep-alive PWM -> GD1 -> Q1 (normal polarity)\nPB4  TIM3_CH1 AF1  Voltmeter PWM -> 10k/100uF RC -> D_V -> J14 pin1
PA9  USART1_TX AF1 UART debug/bootloader TX  115200 8N1\nPA10 USART1_RX AF1 UART RX\nPA13 SWDIO AF0     SWD debug interface\nPA14 SWDCLK AF0    SWD debug interface\nPB6  GPIO out      Status LED (blinks 3x on flash save)\nNRST             Reset input" (at 120 48 0)
    (effects (font (size 1.0 1.0)) (justify left)))
  (text "TOGGLE DECODING:\nPA2=H PA4=H -> Mode A (brushed + positive anti-brake)\nPA2=L PA4=H -> Mode B (brushed, reduced braking only)\nPA2=H PA4=L -> Mode C (brushless, eCom keep-alive)\nPA2=L PA4=L -> invalid -> defaults to Mode B (safe)" (at 15 120 0)
    (effects (font (size 1.0 1.0)) (justify left)))
  (text "RAIL SENSE DIVIDERS:\nWHITE: R8=18k (top) R9=4k7 (bot) -> 3.31V at 16V rail\nBLACK: R10=22k (top) R11=4k7 (bot) -> 2.82V at 16V rail\nBoth safe for 3.3V ADC reference." (at 120 120 0)
    (effects (font (size 1.0 1.0)) (justify left)))
