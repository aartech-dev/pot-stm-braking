(kicad_sch
	(version 20260306)
	(generator "eeschema")
	(generator_version "10.0")
	(uuid "227b1c1c-2b09-4092-b77e-8c6a31167bbc")
	(paper "A3")
	(title_block
		(title "AART Brake Module — 2: MCU + Inputs")
		(date "2026-06-19")
		(rev "11")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "U1 STM32G051K6U6: DAC1 (PA4) brake, PWM (PA5) anti-brake, pot (PA3), toggle (PB0/PB1), rail/BLACK sense, USART1, voltmeter PWM")
	)
	(lib_symbols)
	(text "PA0 ADC_IN0  WHITE rail sense   R8=15k/R9=4k7 divider\nPA1 ADC_IN1  BLACK track sense   R10=22k/R11=4k7 divider (track side of pass switch)\nPA3 ADC_IN3  Pot wiper (10k, CCW = min brake)\nPB0 GPIO in  Toggle bit0 (mode select), pull-up, active-LOW\nPB1 GPIO in  Toggle bit1 (mode select), pull-up, active-LOW\nPB3 GPIO     Reserved (optional reverse-switch enable; unused in Rev 11)"
		(exclude_from_sim no)
		(at 15 32 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "256f6bb2-6e27-4d0e-a174-71de2d59a79f")
	)
	(text "RAIL SENSE DIVIDERS:\nWHITE: R8=15k / R9=4k7 -> within 3.3V ADC at 16V rail\nBLACK: R10=22k / R11=4k7, tapped on the TRACK side of the pass switch"
		(exclude_from_sim no)
		(at 120 140 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2ddc2f78-d7a2-4103-bfa2-d6fc09741d5c")
	)
	(text "PA4  DAC_CH1  Brake -> GD2 op-amp buffer -> Q2 (linear, no PWM)\nPA5  TIM PWM  Anti-brake demand 50kHz -> level-shift+filter -> GD1 current source\nPB4  TIM3_CH1 Voltmeter PWM -> 10k/100uF RC -> D_V -> J14\nPA9  USART1_TX  UART debug/bootloader  115200 8N1\nPA10 USART1_RX  UART RX\nPA13 SWDIO      SWD\nPA14 SWDCLK     SWD\nPB6  GPIO out   Status LED (blinks 3x on flash save)\nNRST            Reset input"
		(exclude_from_sim no)
		(at 120 48 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2f789640-28b8-4375-9b79-e5d7fbe1a65a")
	)
	(text "RIGHT SIDE OUTPUTS:"
		(exclude_from_sim no)
		(at 120 45 0)
		(effects
			(font
				(size 1.2 1.2)
				(bold yes)
			)
		)
		(uuid "7b670c31-cc3a-4504-a8f9-8cae5f24409a")
	)
	(text "DUAL DAC (replaces TIM3 PWM gate drive):\nPA4 DAC_CH1 and PA5 DAC_CH2 drive op-amp buffers in LINEAR mode\n(no switching, no EMI). DAC2 polarity is now non-inverted:\n0% duty = off, full = 3A current source. PWM filtered to DC demand. See doc 7A.7/11.1."
		(exclude_from_sim no)
		(at 120 120 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "7fa49071-3624-42de-81eb-96890143e549")
	)
	(text "U1 STM32G051K6U6 QFN-32"
		(exclude_from_sim no)
		(at 86 60 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "9584a1ba-f061-4774-b641-0a62132412e1")
	)
	(text "LEFT SIDE INPUTS:"
		(exclude_from_sim no)
		(at 35 48 0)
		(effects
			(font
				(size 1.2 1.2)
				(bold yes)
			)
		)
		(uuid "b71dc44d-82a0-4ba4-89c8-b1407a35198f")
	)
	(text "TOGGLE DECODING (PB0=bit0, PB1=bit1, active-LOW pull-up):\nPB0=H PB1=H -> Mode A (brake only, all motors; pot linear)\nPB0=L PB1=H -> Mode B (brake + anti-brake, brushed; coupled tables)\nPB0=H PB1=L -> Mode C (keep-alive tuning, brushless setup)\nboth LOW    -> defaults to Mode A"
		(exclude_from_sim no)
		(at 15 120 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "c8ec25c3-542b-4a5a-9f7b-5d8776d9259d")
	)
	(text "Place U1 here with:\n  C5 100nF + C6 100nF + C7 4u7 (VDD/VDDA decoupling)\n  R1 10k (NRST pull-up to 3.3V)"
		(exclude_from_sim no)
		(at 86 61 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "e7bfe276-2251-4eb1-81d0-3686bda18b1f")
	)
