	(title_block
		(title "AART Brake Module — 3: Debug + Flash Headers")
		(date "2026-06-19")
		(rev "11")
		(company "AART - Adrian & Richard's Technologies")
		(comment 1 "J10 SWD, J11 UART, J12 BOOT0, J13 NRST, J14 voltmeter")
	)
	(lib_symbols)
	(text "J10 — SWD DEBUG HEADER (4-pin 2.54mm)"
		(exclude_from_sim no)
		(at 45 38 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "14384739-2a5d-4c40-9893-031a2c175495")
	)
	(text "Momentary button pulls PB8/BOOT0 to 3.3V via 10k.\nNormally LOW via internal MCU pull-down.\nHold J12 + press J13 = ROM UART bootloader entry on PA9/PA10.\nFlash: stm32flash -w aart_brake.bin /dev/ttyUSB0"
		(exclude_from_sim no)
		(at 85 100 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "325afc69-9f3c-4dc8-8eff-165a53b474e1")
	)
	(text "J13 — NRST BUTTON (2-pin 2.54mm)"
		(exclude_from_sim no)
		(at 45 120 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "48888bc2-3893-413e-81e6-7bd83e6ad382")
	)
	(text "Pin 1: SWDIO (PA13 AF0)\nPin 2: SWDCLK (PA14 AF0)\nPin 3: GND\nPin 4: +3.3V (optional - powers target from programmer)"
		(exclude_from_sim no)
		(at 95 43 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "48d62ac3-dc41-4a98-9170-41f940b267eb")
	)
	(text "Momentary button pulls NRST to GND.\nPress while holding J12 BOOT0 to enter bootloader.\nRelease J13 first, then release J12."
		(exclude_from_sim no)
		(at 85 123 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "49024f67-f298-48ff-942a-f7cc6d7a83b6")
	)
	(text "J11 — UART DEBUG / BOOTLOADER (3-pin 2.54mm)"
		(exclude_from_sim no)
		(at 45 68 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "5234ea2f-eb96-4543-8938-0bafc79d474c")
	)
	(text "Connect ST-Link V2/V3. PA13/PA14 default to SWD after reset.\nFull hardware debug: breakpoints, live variable watch.\nUse debug.sh script: starts OpenOCD + GDB at main()."
		(exclude_from_sim no)
		(at 95 51 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "63a2d600-1ede-4bcd-a506-f48f230494f2")
	)
	(text "J12 — BOOT0 BUTTON (2-pin 2.54mm)"
		(exclude_from_sim no)
		(at 45 98 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "8ba712e1-4031-4f75-8ef4-1d8b95e68c08")
	)
	(text "Telemetry: tick,state,mode,white_mv,black_mv,brake_ccr,\n           ka_ccr,pot_raw,ramp_ms,brake_active,latvian_active\nCommands: SET BRAKE_ENTER/EXIT/SOFT, SET KA_MAX,\n          SET LATVIAN_DVDT, SAVE, GET, HELP"
		(exclude_from_sim no)
		(at 95 83 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "a2999393-ce89-4da3-9deb-56384584b31f")
	)
	(text "USB-C INTERFACE (J_USB + U3 CH340N):\n\nJ_USB (USB-C 16-pin, HRO TYPE-C-31-M-12):\n  VBUS (A4/B4) -> F_USB (500mA polyfuse) -> D_USB (BAT54 anode)\n  D_USB cathode -> LDO input (ORs with WHITE rail path)\n  D+ (A6/B6) -> U3 pin 3\n  D- (A7/B7) -> U3 pin 4\n  CC1 (A5) -> R_CC1 (5.1k) -> GND\n  CC2 (B5) -> R_CC2 (5.1k) -> GND\n  GND (A1/B1/A12/B12) -> GND\n  SBU1/SBU2/SSRX/SSTX: NC\n\nU3 CH340N SOP-8 (JLCPCB C506813):\n  Pin 1 (V3) -> VCC (short to pin 8, 3.3V mode)\n  Pin 2 (GND) -> GND\n  Pin 3 (D+) -> J_USB D+\n  Pin 4 (D-) -> J_USB D-\n  Pin 5 (RXD) -> MCU PA9 (USART1_TX)\n  Pin 6 (TXD) -> MCU PA10 (USART1_RX)\n  Pin 7 (NC)\n  Pin 8 (VCC) -> 3.3V rail + C_USB2 (100nF)\n\nPOWER PRIORITY:\n  WHITE (12-16V) via D_WHITE and USB VBUS (5V) via D_USB\n  both diode-OR into LDO input.\n  WHITE wins on voltage when track connected.\n  USB-only mode: VBUS powers LDO at 5V, FETs unpowered (WHITE=0V),\n  MCU and UART fully functional for bench configuration."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "a7973100-bcf8-4df7-8d69-e8c326822465")
	)
	(text "Pin 1: TX (PA9 USART1 AF1) -> RX of USB-UART adapter\nPin 2: RX (PA10 USART1 AF1) -> TX of USB-UART adapter\nPin 3: GND\n115200 8N1, 3.3V logic level. Do NOT connect 5V directly."
		(exclude_from_sim no)
		(at 95 73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "b073b471-9d4b-48df-b186-60bf175b71b9")
	)
