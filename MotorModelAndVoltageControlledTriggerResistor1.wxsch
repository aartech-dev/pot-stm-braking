Attributes orient="N0" x=3120 y=5280
TextInfo text="From TPS1212-Q1 data sheet:\nAccurate analog bi-directional current monitor\noutput (IMON, I_DIR): ±2% at 30mV VSNS\n\nThis implies ±0.6mV or ±600µV\nwith a 1mohm sense resistor = ±0.6A\n\nDelay to fet off from INP pin = 11.5µs total max"
Property name="StyleNormal" value="DefaultAnnotation" autopos=1 normal="Left" rotated="Left" visible=0 font="Default"
Property name="StyleSelected" value="DefaultSelected" autopos=1 normal="Left" rotated="Left" visible=0 font="Default"
Property name="TextAlignment" value="AlignLeft" autopos=1 normal="Left" rotated="Left" visible=0 font="Default"
.EndTextAnnotation
--SXVERSION1.5
.Instance
Attributes type="symbol" name="Free_text" y=5280 x=3120 orient="N0"
Property name="value" value="From TPS1212-Q1 data sheet:\nAccurate analog bi-directional current monitor\noutput (IMON, I_DIR): ±2% at 30mV VSNS\n\nThis implies ±0.6mV or ±600µV\nwith a 1mohm sense resistor = ±0.6A\n\nDelay to fet off from INP pin = 11.5µs total max" x=0 y=156 align="LeftBase" selectable=1 font="FreeText"
.EndInstance
--EndSXVERSION1.5
.TextAnnotation
Attributes orient="N0" x=3120 y=6480
TextInfo text="V5 = current direction offset error ±140µV\nU1 hysteresis set = ±460µV, so total = ±600µV"
